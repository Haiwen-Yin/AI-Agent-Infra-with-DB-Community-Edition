{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:chuanxu:v5.0.4:research:incident-report:1.0",
  "title": "Public enterprise incident report draft",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "generation_method", "publication_status", "provider", "incident_id", "title", "status", "upstream_impact_label", "reported_started_at", "resolved_at", "declared_window_seconds", "updates", "listed_components", "source", "root_cause", "affected_users", "internal_severity", "recommendations"],
  "properties": {
    "schema_version": {"const": "1.0"},
    "generation_method": {"const": "DETERMINISTIC_PROJECTION"},
    "publication_status": {"const": "DRAFT"},
    "provider": {"enum": ["github", "cloudflare"]},
    "incident_id": {"$ref": "#/$defs/id"},
    "title": {"type": "string", "minLength": 1, "maxLength": 500},
    "status": {"type": "string", "minLength": 1, "maxLength": 80},
    "upstream_impact_label": {"type": "string", "minLength": 1, "maxLength": 80},
    "reported_started_at": {"$ref": "#/$defs/time"},
    "resolved_at": {"$ref": "#/$defs/time"},
    "declared_window_seconds": {"type": ["number", "null"], "minimum": 0},
    "root_cause": {"type": "null", "description": "Not extracted by this deterministic prototype"},
    "affected_users": {"type": "null"},
    "internal_severity": {"type": "null"},
    "recommendations": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
    "listed_components": {
      "type": "array", "maxItems": 100,
      "items": {"type": "object", "additionalProperties": false, "required": ["id", "name"],
        "properties": {"id": {"$ref": "#/$defs/id"}, "name": {"type": "string", "minLength": 1, "maxLength": 500}}}
    },
    "updates": {
      "type": "array", "maxItems": 100,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["update_id", "status", "display_at", "created_at", "updated_at", "body", "body_sha256"],
        "properties": {
          "update_id": {"$ref": "#/$defs/id"},
          "status": {"type": "string", "minLength": 1, "maxLength": 80},
          "display_at": {"$ref": "#/$defs/time"},
          "created_at": {"$ref": "#/$defs/time"},
          "updated_at": {"$ref": "#/$defs/time"},
          "body": {"type": "string", "minLength": 1, "maxLength": 12000},
          "body_sha256": {"$ref": "#/$defs/hash"}
        }
      }
    },
    "source": {
      "type": "object", "additionalProperties": false,
      "required": ["api_url", "incident_url", "snapshot_sha256", "record_sha256", "acquired_at"],
      "properties": {
        "api_url": {"enum": ["https://www.githubstatus.com/api/v2/incidents.json", "https://www.cloudflarestatus.com/api/v2/incidents.json"]},
        "incident_url": {"type": "string", "pattern": "^https://www\\.(githubstatus|cloudflarestatus)\\.com/incidents/[a-z0-9]{1,64}$"},
        "snapshot_sha256": {"$ref": "#/$defs/hash"},
        "record_sha256": {"$ref": "#/$defs/hash"},
        "acquired_at": {"type": "string", "format": "date-time"}
      }
    }
  },
  "$defs": {
    "id": {"type": "string", "pattern": "^[a-z0-9]{1,64}$"},
    "hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "time": {"type": ["string", "null"], "format": "date-time"}
  }
}
